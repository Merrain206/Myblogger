# 使用 scripts/generate-auth-config.ts 生成以下两个值。
AUTH_PASSWORD_HASH=
AUTH_TOKEN_SECRET=

# 会话有效期，单位秒，允许范围 300 到 86400。
AUTH_TOKEN_TTL_SECONDS=

# 逗号分隔的完整站点 Origin，例如 https://example.com。
ALLOWED_ORIGINS=

# SQLite 文件绝对路径，或相对项目根目录的路径。
DATABASE_PATH=

# Hermes 管理媒体私有目录，不能放在 public 下。
HERMES_MEDIA_PATH=

# 仅在 Nginx 等可信反向代理前启用；WebSocket 还需配置可信代理 IP。
TRUST_PROXY=
TRUSTED_PROXY_IPS=

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=
DEEPSEEK_MODEL=

# AI 成本与滥用控制。
AI_IP_REQUESTS_PER_MINUTE=
AI_ACCOUNT_REQUESTS_PER_MINUTE=
AI_GLOBAL_CONCURRENCY=
AI_DAILY_REQUEST_LIMIT=
AI_DAILY_TOKEN_LIMIT=
AI_DAILY_COST_USD_LIMIT=
AI_ESTIMATED_COST_PER_MILLION_USD=
AI_UPSTREAM_TIMEOUT_MS=
AI_UPSTREAM_MAX_RETRIES=
